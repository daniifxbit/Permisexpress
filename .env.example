# Variables d'environnement — à renseigner dans Vercel
# (Project → Settings → Environment Variables), et localement dans un
# fichier .env que Git ignore. Voir README.md § Mise en service.

# --- Supabase -------------------------------------------------------------
# Dashboard Supabase → Project Settings → Data API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Dashboard Supabase → Project Settings → API Keys → service_role
# SECRET : contourne toutes les règles d'accès. Ne jamais l'exposer côté
# navigateur, ne jamais la committer.
SUPABASE_SERVICE_ROLE_KEY=

# --- Espace administrateur ------------------------------------------------
# Générer les deux valeurs avec : npm run code-admin
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
